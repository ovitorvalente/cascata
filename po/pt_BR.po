msgstr "Não foi possível executar o pkexec: {error}"

#: src/deps.rs:186
msgid "Authentication was cancelled."
msgstr "A autenticação foi cancelada."

#: src/deps.rs:187
msgid "Not authorized to install packages."
msgstr "Autorização negada para instalar pacotes."

#: src/deps.rs:202
msgid "The installation stopped unexpectedly."
msgstr "A instalação foi interrompida inesperadamente."

#: src/deps.rs:210
msgid "The package manager exited with an error."
msgstr "O gerenciador de pacotes terminou com erro."

#: src/downloader.rs:187
