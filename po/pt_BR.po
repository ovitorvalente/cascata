msgstr "yt-dlp e FFmpeg estão instalados"

#: src/window.rs:392
#, rust-format
msgid "{tools} is not installed"
msgid_plural "{tools} are not installed"
msgstr[0] "{tools} não está instalado"
msgstr[1] "{tools} não estão instalados"

#: src/window.rs:397 src/window.rs:432
msgid "Install"
msgstr "Instalar"

#: src/window.rs:400
#, rust-format
msgid ""
"{tools} is not installed. Install it with your system's package manager."
msgid_plural ""
"{tools} are not installed. Install them with your system's package manager."
msgstr[0] ""
"{tools} não está instalado. Instale pelo gerenciador de pacotes do seu "
"sistema."
msgstr[1] ""
"{tools} não estão instalados. Instale pelo gerenciador de pacotes do seu "
"sistema."

#: src/window.rs:424
#, rust-format
msgid ""
"Cascata needs {tools} to work. The command below will run as administrator "
"and you will be asked for your password:\n"
"\n"
"{command}"
msgstr ""
"O Cascata precisa de {tools} para funcionar. O comando abaixo será executado "
"como administrador e a sua senha será solicitada:\n"
"\n"
"{command}"

#: src/window.rs:431
msgid "Install dependencies?"
msgstr "Instalar dependências?"

#: src/window.rs:443
msgid "Installing dependencies…"
msgstr "Instalando dependências…"

#: src/window.rs:452
msgid "Dependencies installed"
msgstr "Dependências instaladas"

#: src/window.rs:455
msgid "Installation incomplete"
msgstr "Instalação incompleta"

#: src/window.rs:457
msgid ""
"The package manager finished, but the tools still could not be found in the "
"PATH."
msgstr ""
"O gerenciador de pacotes terminou, mas as ferramentas ainda não foram "
"encontradas no PATH."

#: src/window.rs:461
msgid "Could not install"
msgstr "Não foi possível instalar"

#: src/window.rs:498
msgid "Enter the video address"
msgstr "Informe o endereço do vídeo"

#: src/window.rs:505
msgid "The address must start with http:// or https://"
msgstr "O endereço precisa começar com http:// ou https://"

#: src/window.rs:534
msgid "Could not start yt-dlp"
msgstr "Não foi possível iniciar o yt-dlp"

#: src/window.rs:542
msgid "Fetching information…"
msgstr "Obtendo informações…"

#: src/window.rs:543
msgid "Connecting…"
msgstr "Conectando…"

